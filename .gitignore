# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hedge protocol (vendored repos restored via protocol/setup-vendor.sh)
/protocol/lib/
/protocol/out/
/protocol/cache/
/protocol/broadcast/
/protocol/deployments/31337.json
/services/node_modules/
/services/*/node_modules/
/services/*/dist/
/protocol/.env
/services/**/.env

# terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/.terraform.tfstate.lock.info

# turbo
.turbo/
**/.turbo/
