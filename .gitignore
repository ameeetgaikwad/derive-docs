# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (templates can be committed explicitly)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hedge protocol (vendored repos restored via protocol/setup-vendor.sh)
/protocol/lib/
/protocol/out/
/protocol/cache/
/protocol/broadcast/
/protocol/deployments/31337.json
/services/node_modules/
/services/*/node_modules/
/services/*/dist/
/protocol/.env
/services/**/.env
/services/oracle-feeds/.data/
/services/rfq-engine/.data/

# terraform
infra/.terraform/
infra/**/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
infra/.terraform.tfstate.lock.info
infra/**/.terraform.tfstate.lock.info
infra/tfplan
infra/**/tfplan

# turbo
.turbo/
**/.turbo/
