{
  "name": "@hedge/rfq-engine",
  "version": "0.1.0",
  "private": true,
  "description": "RFQ auction + execution service: maker WS channel, taker REST/WS, on-chain RfqModule executor",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "pnpm build && vitest run"
  },
  "dependencies": {
    "@hedge/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
