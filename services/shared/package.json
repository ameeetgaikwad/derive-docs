{
  "name": "@hedge/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TS library: ABIs, EIP-712 action signing, RFQ encoding, feed signing, viem clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "default": "./dist/abis/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "extract-abis": "node scripts/extract-abis.mjs",
    "build": "node scripts/extract-abis.mjs && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "smoke": "pnpm build && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1078.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
