{
  "name": "@hedge/rfq-market-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Shadow-first, risk-managed RFQ options market maker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/shadow-demo.ts",
    "start": "node dist/shadow-demo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "smoke": "pnpm build && vitest run && node dist/shadow-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
