{
  "name": "@hedge/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end acceptance harness: anvil -> deploy -> feeds -> RFQ covered-call trade -> settlement (OTM + ITM)",
  "type": "module",
  "main": "./dist/run.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bootstrap:rwa:testnet": "tsx src/bootstrap-rwa-testnet.ts",
    "deploy:rwa:testnet": "tsx src/deploy-rwa-testnet.ts",
    "activate:rwa:testnet": "tsx src/activate-rwa-testnet.ts",
    "deploy:rwa:mainnet-staging": "tsx src/deploy-rwa-mainnet-staging.ts",
    "bootstrap:rwa:mainnet-staging": "tsx src/bootstrap-rwa-mainnet-staging.ts",
    "activate:rwa:mainnet-staging": "tsx src/activate-rwa-mainnet-staging.ts",
    "e2e": "tsx src/run.ts",
    "dev": "tsx src/run.ts",
    "smoke": "pnpm build && tsx src/run.ts",
    "test": "tsx --test src/rwa-testnet.test.ts"
  },
  "dependencies": {
    "@hedge/oracle-feeds": "workspace:*",
    "@hedge/shared": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
