{
  "name": "hedge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hedge/shared --filter=@hedge/oracle-feeds --filter=@hedge/rfq-engine --filter=@hedge/maker-bot --filter=@hedge/web",
    "deploy:rwa:testnet": "pnpm --filter @hedge/e2e deploy:rwa:testnet --market XAU,SPY,NVDA --broadcast",
    "deploy:rwa:testnet:plan": "pnpm --filter @hedge/e2e deploy:rwa:testnet --market XAU,SPY,NVDA",
    "activate:rwa:testnet": "pnpm --filter @hedge/e2e activate:rwa:testnet",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.3"
  }
}
