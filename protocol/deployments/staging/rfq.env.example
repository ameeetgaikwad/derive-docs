# Isolated chain-56 staging RFQ engine. Copy outside the repository and replace
# every placeholder before use. Do not place private keys in this file.
CHAIN_ID=56
RPC_URL=https://replace-with-private-bsc-mainnet-rpc

# Both paths are intentionally isolated from the canonical chain-56 deployment.
SATS_DEPLOYMENTS_DIR=/absolute/path/to/derive/protocol/deployments/staging
HEDGE_MARKETS_DIR=/absolute/path/to/derive/protocol/deployments/staging/markets

# Public staging: there is no taker allowlist, so every client that can reach the
# HTTPS/WSS reverse proxy may request an RFQ. Keep the engine itself on loopback.
TAKER_OPEN=true
HOST=127.0.0.1
RFQ_PORT=3030
RFQ_RATE_LIMIT_PER_MIN=5

# Required: comma-separated staging maker EOAs. Never leave this empty on chain 56.
MAKER_ALLOWLIST=0xREPLACE_WITH_STAGING_MAKER_ADDRESS

# Use the registered staging executor through KMS; never put its private key here.
EXECUTOR_KMS_KEY_ID=alias/replace-with-staging-executor
STORE_PATH=/absolute/path/to/durable/staging-rfq.jsonl
